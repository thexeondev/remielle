.{
    // UDP bind address for the main socket.
    // Can be overridden by the `-b` option.
    .game_bind_address = "127.0.0.1:20501",

    // UDP bind address for the control socket.
    // Can be overridden by the `-B` option.
    .ctl_bind_address = "127.0.0.1:15810",

    // The amount of sessions allowed to be processed concurrently.
    // Zero means unlimited amount.
    // Can be overridden by the `-c` option.
    .concurrent_sessions_limit = 0,

    // The first player UID.
    // All created account UIDs will be relative to this.
    .base_player_uid = 666, // the number of the beast

    // Also known as "Shiyu Defense" and "Deadly Assault".
    .hadal_zone_entrances = .{
        .{ .id = .hadal_zone_scheduled, .zone = 620561 },
        .{ .id = .hadal_zone_stable, .zone = 61001 },
        .{ .id = .hadal_zone_defensive, .zone = 61002 },
        .{ .id = .boss_challenge_normal, .zone = 6904211 },
        .{ .id = .boss_challenge_hard, .zone = 690422 },
    },

    .dummy_cmd = "IECPJKNJHCF",
}
