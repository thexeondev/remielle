.{
    // UDP bind address for the main socket.
    // Can be overridden by the `--game-bind-address` option.
    .game_bind_address = "127.0.0.1:20501",

    // UDP bind address for the control socket.
    // Can be overridden by the `--ctl-bind-address` option.
    .ctl_bind_address = "127.0.0.1:15810",

    // The first player UID.
    // All created account UIDs will be relative to this.
    .base_player_uid = 666, // the number of the beast

    .dummy_cmd = "JGNEPBHAFOO",
}
